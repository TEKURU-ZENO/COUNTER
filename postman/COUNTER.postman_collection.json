{
  "info": {
    "name": "COUNTER API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requests and checks for the COUNTER API. Set baseUrl to the web origin (it proxies /api) or the API directly. The call folder needs an LLM configured; the merchant folder needs ownerEmail/ownerPassword. Webhook checks run in any PayPal mode."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3010"
    },
    {
      "key": "ownerEmail",
      "value": ""
    },
    {
      "key": "ownerPassword",
      "value": ""
    },
    {
      "key": "callerPhone",
      "value": "+1 415 555 0190"
    }
  ],
  "item": [
    {
      "name": "1. Health and menu",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"reports PayPal mode explicitly\", () => pm.expect([\"mock\",\"sandbox\",\"live\"]).to.include(b.paypal_mode));"
                ]
              }
            }
          ]
        },
        {
          "name": "Menu",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "menu"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const items = pm.response.json();",
                  "pm.test(\"prices are integer cents\", () => items.forEach(i => pm.expect(Number.isInteger(i.price_cents)).to.be.true));",
                  "if (items.length) pm.collectionVariables.set(\"firstItemId\", items[0].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. A call (needs an LLM)",
      "item": [
        {
          "name": "Start call",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/calls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "calls"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caller_phone\": \"{{callerPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"call started or LLM explicitly unavailable\", () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) { const b = pm.response.json(); pm.collectionVariables.set(\"callId\", b.call_id); pm.collectionVariables.set(\"callToken\", b.call_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Order something",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Call-Token",
                "value": "{{callToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/calls/{{callId}}/turns",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "calls",
                "{{callId}}",
                "turns"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"One margherita pizza please\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"agent replied\", () => pm.expect(b.speech).to.be.a(\"string\").and.not.empty);",
                  "if (b.order) pm.test(\"server priced the order\", () => pm.expect(b.order.total_cents).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask for the payment link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Call-Token",
                "value": "{{callToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/calls/{{callId}}/turns",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "calls",
                "{{callId}}",
                "turns"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Yes, send me the PayPal link\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "if (b.order && b.order.state === \"LINK_SENT\") { pm.test(\"PayPal checkout link\", () => pm.expect(b.order.approval_url).to.match(/paypal\\.com|mock-paypal/)); pm.collectionVariables.set(\"orderId\", b.order.id); pm.collectionVariables.set(\"statusToken\", new URLSearchParams(b.order.status_url.split(\"?\")[1]).get(\"t\")); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer status (signed link)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/status?t={{statusToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}",
                "status"
              ],
              "query": [
                {
                  "key": "t",
                  "value": "{{statusToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"no caller identifiers exposed\", () => pm.expect(pm.response.json()).to.not.have.property(\"caller_hash\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer status with forged token is refused",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/status?t=forged",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{orderId}}",
                "status"
              ],
              "query": [
                {
                  "key": "t",
                  "value": "forged"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Turn with a forged call token is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Call-Token",
                "value": "forged"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/calls/{{callId}}/turns",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "calls",
                "{{callId}}",
                "turns"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"hi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Webhook safety",
      "item": [
        {
          "name": "Missing PayPal headers -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/paypal/webhooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "paypal",
                "webhooks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-TEST\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"resource\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forged signature -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "paypal-transmission-id",
                "value": "t1"
              },
              {
                "key": "paypal-transmission-time",
                "value": "2026-01-01T00:00:00Z"
              },
              {
                "key": "paypal-cert-url",
                "value": "https://api.sandbox.paypal.com/v1/notifications/certs/CERT-x"
              },
              {
                "key": "paypal-auth-algo",
                "value": "SHA256withRSA"
              },
              {
                "key": "paypal-transmission-sig",
                "value": "Zm9yZ2Vk"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/paypal/webhooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "paypal",
                "webhooks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-TEST-2\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"resource\": {\n    \"custom_id\": \"x\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Non-PayPal cert URL -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "paypal-transmission-id",
                "value": "t1"
              },
              {
                "key": "paypal-transmission-time",
                "value": "2026-01-01T00:00:00Z"
              },
              {
                "key": "paypal-cert-url",
                "value": "https://evil.example.com/cert"
              },
              {
                "key": "paypal-auth-algo",
                "value": "SHA256withRSA"
              },
              {
                "key": "paypal-transmission-sig",
                "value": "Zm9yZ2Vk"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/paypal/webhooks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "paypal",
                "webhooks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"WH-TEST-3\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"resource\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Merchant",
      "item": [
        {
          "name": "Orders without a session -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Agent API without service token -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agent/calls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "agent",
                "calls"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caller_phone\": \"{{callerPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refund approvals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/approvals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "approvals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refund above captured amount is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/orders/{{orderId}}/refunds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "orders",
                "{{orderId}}",
                "refunds"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount_cents\": 99999999,\n  \"client_request_id\": \"postman-overrefund-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"refused\", () => pm.expect([404, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Copilot (grounded, read-only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchant/copilot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchant",
                "copilot"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How much did we refund this week?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"answered or LLM unavailable\", () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.test(\"figures are traced or withheld\", () => { const b = pm.response.json(); pm.expect(b.grounded || b.untraced_figures.length > 0 || !/[0-9]/.test(b.answer)).to.be.true; });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}