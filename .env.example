# COUNTER configuration. Copy to .env. Every value is read by apps/core/settings.py.

# --- Environment -------------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
RUN_WORKER_IN_PROCESS=true         # single-process dev; deployments run apps.worker.worker separately

# --- Storage ------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./counter_dev.db   # Postgres in deployments: postgresql://...
REDIS_URL=                         # empty = in-process event bus (single process only)

# --- Secrets (generate: python -c "import secrets; print(secrets.token_urlsafe(32))") ---
SECRET_KEY=
CALLER_HASH_KEY=
SERVICE_TOKEN=

# --- URLs ---------------------------------------------------------------------
WEB_BASE_URL=http://localhost:3000   # the only origin CORS allows; PayPal return URLs point here
API_PUBLIC_URL=http://localhost:8000 # used to verify Twilio signatures

# --- Merchant login -----------------------------------------------------------
OWNER_EMAIL=
OWNER_PASSWORD_HASH=               # python -m infra.scripts.hash_password

# --- PayPal ---------------------------------------------------------------------
# Required, never inferred: mock | sandbox | live. sandbox/live refuse to start without credentials.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                 # from the webhook you register at <WEB_BASE_URL>/api/v1/paypal/webhooks
PAYPAL_PARTNER_ATTRIBUTION_ID=
# Only for the opt-in sandbox test suite (pytest -m sandbox):
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# --- LLM ----------------------------------------------------------------------
# anthropic | openai_compatible (OpenAI, Groq, ...). Without these, calls return 503.
LLM_PROVIDER=
LLM_MODEL=
VISION_MODEL=                      # menu photo extraction (Anthropic vision model)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # Groq: https://api.groq.com/openai/v1

# --- Phone channel & SMS (Twilio) -----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
HUMAN_HANDOFF_NUMBER=
DEMO_SMS_INBOX=false               # web demo shows texted codes; refused in production / live PayPal

# --- Integrations (optional) ----------------------------------------------------
ZAPIER_WEBHOOK_URL=
ZAPIER_SIGNING_SECRET=
KERNEL_API_KEY=                    # hosted browser for the sandbox approval test
OTEL_EXPORTER_OTLP_ENDPOINT=       # e.g. Elastic APM OTLP endpoint
OTEL_EXPORTER_OTLP_HEADERS=
