# ==============================================================================
# COUNTER: AI Phone Agent for Independent Takeaway Restaurants
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=counter_super_secret_dev_key_change_in_production_32chars
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database & Cache
# ------------------------------------------------------------------------------
# For local development without Docker, sqlite+aiosqlite can be used, or Postgres
DATABASE_URL=postgresql+asyncpg://counter:counter@localhost:5432/counter
# Fallback local sqlite for standalone testing:
# DATABASE_URL=sqlite+aiosqlite:///./counter.db
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# PayPal REST API (Sandbox)
# ------------------------------------------------------------------------------
# Get credentials from developer.paypal.com dashboard
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_PARTNER_ATTRIBUTION_ID=Counter_Takeaway_AI

# Seed Sandbox Test Accounts (for demo UI display)
PAYPAL_SANDBOX_BUSINESS_EMAIL=merchant@countertakeaway.test
PAYPAL_SANDBOX_BUYER_EMAIL=buyer@personal.example.com
PAYPAL_SANDBOX_BUYER_PASSWORD=TestPass123!

# ------------------------------------------------------------------------------
# LiveKit Cloud (Voice & WebRTC)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# Speech & AI Providers (STT / LLM / TTS)
# ------------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key
OPENAI_API_KEY=your_openai_or_groq_api_key
GROQ_API_KEY=your_groq_api_key
CARTESIA_API_KEY=your_cartesia_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ------------------------------------------------------------------------------
# Twilio (SIP & SMS notifications)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+18005550199
TWILIO_MESSAGING_SERVICE_SID=
